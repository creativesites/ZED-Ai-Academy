# Copy to .env.local and fill in. Never commit real values.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_FOUNDER_WHATSAPP=

# --- Clerk ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Jitsi as a Service (8x8 JaaS) — live classroom video ---
# App ID looks like vpaas-magic-cookie-xxxxxxxx
JAAS_APP_ID=
# Key ID looks like vpaas-magic-cookie-xxxxxxxx/abc123
JAAS_KEY_ID=
# RSA private key for the Key ID. Either the PEM with "\n" escapes, or base64 of the PEM file.
JAAS_PRIVATE_KEY=

# --- Zoom Meeting SDK (embedded join) ---
ZOOM_MEETING_SDK_KEY=
ZOOM_MEETING_SDK_SECRET=
NEXT_PUBLIC_ZOOM_MEETING_SDK_KEY=
# Legacy fallbacks for the Meeting SDK key/secret
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
NEXT_PUBLIC_ZOOM_CLIENT_ID=

# --- Zoom Server-to-Server OAuth (creating meetings) ---
ZOOM_ACCOUNT_ID=
ZOOM_SERVER_CLIENT_ID=
ZOOM_SERVER_CLIENT_SECRET=
ZOOM_HOST_USER_ID=

# --- AI (Google GenAI SDK reads this automatically) ---
GEMINI_API_KEY=
# Alternative name accepted by the ZAI Tutor routes
GOOGLE_API_KEY=
# Set to "true" to enable the public ZAI Tutor demo routes
TUTOR_DEMO_ENABLED=

# --- Payments (PayChangu) ---
PAYCHANGU_SECRET_KEY=

# --- Email (EmailJS) ---
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_TEMPLATE_WELCOME=
EMAILJS_TEMPLATE_ENROLLMENT=
EMAILJS_TEMPLATE_PAYMENT=
EMAILJS_TEMPLATE_CERTIFICATE=

# --- Internal ---
ADMIN_SYNC_SECRET=
